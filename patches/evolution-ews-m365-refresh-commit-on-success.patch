+/* Save the resume URL after a page that is not the last one. Adds are already
+ * in the summary. Removals stay listed until the walk reaches its deltaLink. */
+static void
+letter_m365_note_page_checkpoint (SummaryDeltaData *sdd,
+				  EM365Connection *cnc)
+{
+	const gchar *next_link;
+	const gchar *delta_link;
+	CamelM365FolderSummary *m365_summary;
+	GString *pending;
+	guint ii;
+
+	next_link = g_object_get_data (G_OBJECT (cnc), "letter-m365-page-next");
+	delta_link = g_object_get_data (G_OBJECT (cnc), "letter-m365-page-delta");
+	if (delta_link != NULL && *delta_link != '\0')
+		return;
+	if (next_link == NULL || *next_link == '\0')
+		return;
+
+	m365_summary = CAMEL_M365_FOLDER_SUMMARY (camel_folder_get_folder_summary (sdd->folder));
+	camel_m365_folder_summary_set_delta_link (m365_summary, next_link);
+
+	pending = g_string_new ("");
+	if (sdd->removed_uids != NULL) {
+		for (ii = 0; ii < sdd->removed_uids->len; ii++) {
+			const gchar *uid = g_ptr_array_index (sdd->removed_uids, ii);
+
+			if (uid == NULL || *uid == '\0')
+				continue;
+			if (pending->len > 0)
+				g_string_append_c (pending, '\n');
+			g_string_append (pending, uid);
+		}
+	}
+	camel_m365_folder_summary_set_pending_removed (m365_summary, pending->len > 0 ? pending->str : NULL);
+	g_string_free (pending, TRUE);
+
+	m365_folder_save_summary (CAMEL_M365_FOLDER (sdd->folder));
+	sdd->checkpointed = TRUE;
+}
