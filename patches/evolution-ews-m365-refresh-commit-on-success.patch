+static void
+letter_m365_load_pending_removed (CamelM365FolderSummary *summary,
+				  SummaryDeltaData *sdd)
+{
+	gchar *blob, **uids;
+	gint ii;
+
+	blob = camel_m365_folder_summary_dup_pending_removed (summary);
+	if (blob == NULL || *blob == '\0') {
+		g_free (blob);
+		return;
+	}
+
+	uids = g_strsplit (blob, "\n", -1);
+	for (ii = 0; uids != NULL && uids[ii] != NULL; ii++) {
+		if (uids[ii][0] == '\0')
+			continue;
+
+		if (sdd->removed_uids == NULL)
+			sdd->removed_uids = g_ptr_array_new_with_free_func ((GDestroyNotify) camel_pstring_free);
+		g_ptr_array_add (sdd->removed_uids, (gpointer) camel_pstring_strdup (uids[ii]));
+	}
+
+	g_strfreev (uids);
+	g_free (blob);
+}
